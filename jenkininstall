Step 1: Update the system 
          sudo apt update 
          sudo apt upgrade -y 
 
      Step 2: Install Java (Jenkins requirement) 
         sudo apt install openjdk-21-jdk -y 
         Verify Java: 
         java -version 
 
      Step 3: Add the Jenkins repository key 
       curl -fsSL https://pkg.jenkins.io/debian-stable/jenkins.io-2023.key | sudo tee \ 
       /usr/share/keyrings/jenkins-keyring.asc > /dev/null 
 
      Step 4: Add the Jenkins repository 
      echo "deb [signed-by=/usr/share/keyrings/jenkins-keyring.asc] https://pkg.jenkins.io/debian-stable binary/" | sudo      
     tee \ /etc/apt/sources.list.d/jenkins.list > /dev/null 
 
     Step 5: Update package list 
     Sudo apt update 
 
     Step 6: Install Jenkins 
       sudo apt install jenkins -y 
 
     Step 7: Start Jenkins 
      sudo systemctl start Jenkins 
 
     Step 8: Enable Jenkins at boot 
      sudo systemctl enable Jenkins 
 
     Step 9: Check Jenkins status 
      sudo systemctl status Jenkins 
 
     Step 10: Get the initial administrator password 
      sudo cat /var/lib/jenkins/secrets/initialAdminPassword 
 
     Step 11: Open Jenkins in a browser 
      http://localhost:8080 
    or 
     http://<your-ip-address>:8080 
 
      Step 12: Unlock Jenkins 
 Paste the administrator password. 
 Click Continue. 
 
      Step 13: Install suggested plugins 
 Click Install Suggested Plugins. 
 
      Step 14: Create the first administrator account 
 Enter Username 
 Password 
 Full Name 
 Email Address 

 
